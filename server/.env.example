# ===== Server =====
PORT=3001

# ===== CORS =====
# Comma-separated list of allowed origins. Use * during development.
CLIENT_ORIGIN=http://localhost:5173

# ===== Google Sheets =====
# The ID of your Google Sheet (found in the sheet URL: /d/SHEET_ID/edit)
GOOGLE_SHEET_ID=your-google-sheet-id-here
# The tab/worksheet name inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Path to the Google service account JSON key file.
# Download this from Google Cloud Console (see README for setup).
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json

# ===== Email (SMTP) =====
# The email address that will SEND the notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# The email address that will RECEIVE the notifications.
NOTIFY_EMAIL=service@syncmindautomation.com
